table FactVentas
	lineageTag: 4af4c6ee-555c-46d7-ab42-c3d646726962

	measure 'Ventas Brutas' =
			
			SUMX(
			    FactVentas,
			    FactVentas[Cantidad] *
			    FactVentas[PrecioUnitario]
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Ventas
		lineageTag: 8ba21320-546c-49e1-a096-d427c1804649

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Costo Total' =
			
			SUMX(
			    FactVentas,
			    FactVentas[Cantidad] *
			    FactVentas[CostoUnitario]
			)
		formatString: 0
		displayFolder: Costos
		lineageTag: e592b634-575e-4ed6-aebb-dcba0b945f41

	measure 'Utilidad Bruta' =
			
			[Ventas Brutas] - [Costo Total]
		formatString: 0
		displayFolder: Rentabilidad
		lineageTag: 7082cfaf-d079-49b5-95ff-a5f5fb10dac0

	measure 'Margen %' =
			
			DIVIDE(
			    [Utilidad Bruta],
			    [Ventas Brutas]
			)
		displayFolder: Rentabilidad
		lineageTag: 57410baa-adcc-4540-814f-567452268e09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad Operaciones' =
			
			DISTINCTCOUNT(
			    FactVentas[IdVenta]
			)
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 4aaff251-14d0-4956-b307-28d8410997db

	measure 'Ticket Promedio' =
			
			DIVIDE(
			    [Ventas Brutas],
			    [Cantidad Operaciones]
			)
		displayFolder: Indicadores
		lineageTag: 538e092c-0ab4-4945-a68f-58abad5cc130

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column IdVenta
		dataType: int64
		formatString: 0
		lineageTag: fab7d4bb-30b2-4c8f-999a-c530b4bf58b8
		summarizeBy: sum
		sourceColumn: IdVenta

		annotation SummarizationSetBy = Automatic

	column IdProducto
