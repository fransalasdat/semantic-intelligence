# Copiar a .env en la raíz del repositorio y completar localmente.
# Nunca compartir ni versionar la clave real.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# OpenAI es opcional y solo se utiliza con AI_PROVIDER=openai.
OPENAI_API_KEY=
# Ejemplo configurable; debe estar habilitado en tu cuenta y admitir Responses + Structured Outputs.
OPENAI_MODEL=gpt-5.4-mini
